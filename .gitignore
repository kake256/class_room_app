docs/calibration-policy.md

# 学生の個人情報を含むCSV(氏名・メール・成績)
*.csv

# サンプル提出物
samples/*.pdf
samples/*.png

# 一時ファイル
dfout.txt
*.log

# Python
__pycache__/
*.pyc
.pytest_cache/
