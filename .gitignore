# 生成物・実行時データ(学生の提出物・採点結果・ログを含む)
data/

# 認証情報・トークン(バックアップ含む)
credentials.json
token.json
token.json.bak*
*.bak

# インスタンス固有の設定(コースID・学生ID・courseWorkIdを含む)
config.yaml

